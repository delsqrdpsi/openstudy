{
  "name": "openstudy",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @openstudy/web --filter @openstudy/tutor dev",
    "dev:web": "pnpm --filter @openstudy/web dev",
    "dev:tutor": "pnpm --filter @openstudy/tutor dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "figures:seed": "pnpm --filter @openstudy/tutor figures:seed",
    "figures:import": "pnpm --filter @openstudy/tutor figures:import"
  },
  "engines": {
    "node": ">=22.13"
  }
}
