# Copy to .env (the tutor server loads it) or export in your shell.

# Brain. claude-code uses the `claude` CLI you are logged in with; codex uses
# the `codex` CLI (`codex login`, ChatGPT plan). Model names for the other
# brain are ignored, so these defaults are safe to leave when switching.
BRAIN=claude-code
TUTOR_MODEL=sonnet        # live tutor: sonnet | opus | fable; with codex, one of the ids in the model menu (default: Codex's own)
PLANNER_MODEL=fable       # lesson planner, one call per lesson; with codex, default is Codex's own model
# CODEX_EFFORT=low        # codex only: reasoning effort for live turns (default: the model's own, usually low)
# PLANNER_EFFORT=high     # codex only: reasoning effort for the planner
# CODEX_BIN=codex         # path to the codex CLI if it is not on PATH
TUTOR_PERSONA=openstudy   # openstudy | hype (energetic, bold terms, recaps, analogies)
PLAN_WAIT_MS=4000         # how long the first teaching turn waits for the plan before starting on a provisional one

# Pictures. Leave all unset for no pictures (diagrams still work).
# IMAGES=gemini | openai | fal | none   (default: gemini if GEMINI_API_KEY is set)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1        # gpt-image-1-mini is a bit faster and much cheaper
# OPENAI_IMAGE_QUALITY=low              # low | medium | high; low is ~8s, medium ~15-25s
# OPENAI_IMAGE_SIZE=1536x1024
FAL_KEY=

# Voice. With a Deepgram key the tutor speaks with Aura-2 and listens with Nova,
# streamed through the tutor server (the key stays here). Without one, the
# browser's own speech synthesis and recognition are used (mic: Chrome/Edge only).
DEEPGRAM_API_KEY=
# VOICE=deepgram | browser        (default: deepgram if the key is set)
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# DEEPGRAM_STT_MODEL=nova-3

# Sources (folders of slides and PDFs). Pages beyond this per file are skipped.
# SOURCE_MAX_PAGES=80

# Where generated images, boards and prepared source pages are stored.
# DATA_DIR=./data
# TUTOR_PORT=8787
# TUTOR_PUBLIC_URL=http://localhost:8787

# Who may reach the tutor server. It holds your keys and can read folders on
# this machine, so by default it listens on this machine only and answers only
# the board's own pages. Change these only when serving it to others.
# TUTOR_HOST=127.0.0.1                    # 0.0.0.0 behind a hosting proxy
# WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # where the board is served from
# TUTOR_ALLOWED_HOSTS=                    # extra hostnames this server answers to (TUTOR_PUBLIC_URL's is included)
# FOLDER_SCAN=on                          # off on a hosted server: it reads folder paths off the server's disk
