# Copy to .env (the tutor server loads it) or export in your shell.

# Brain. claude-code uses the `claude` CLI you are logged in with.
BRAIN=claude-code
TUTOR_MODEL=sonnet        # live tutor: sonnet | opus | fable
PLANNER_MODEL=fable       # lesson planner, one call per lesson
TUTOR_PERSONA=openstudy   # openstudy | studdy (energetic, bold terms, recaps, analogies)
PLAN_WAIT_MS=12000        # how long the first teaching turn waits for the plan before starting without it

# Pictures. Leave all unset for no pictures (diagrams still work).
# IMAGES=gemini | openai | fal | none   (default: gemini if GEMINI_API_KEY is set)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
# OPENAI_IMAGE_QUALITY=medium
FAL_KEY=

# Where generated images are stored and served from.
# DATA_DIR=./data
# TUTOR_PORT=8787
# TUTOR_PUBLIC_URL=http://localhost:8787
